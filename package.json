{
  "name": "death-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "postinstall": "simple-git-hooks",
    "type-check": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "core-js": "^3.50.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.10",
    "marked-highlight": "^2.2.4",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "@unocss/vite": "^66.8.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "lint-staged": "^17.3.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "unocss": "^66.8.0",
    "vite": "^8.2.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "node scripts/verify-commit.mjs $1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,json,md,yml,yaml,css,html}": "prettier --write",
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.22.0"
}
